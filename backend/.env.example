# ==============================================================================
# Centralized AI Engine (AXIOM AI) - Environment Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` and update the values as needed.
# DO NOT commit real secrets or credentials to source control.

# --- LLM Provider Configuration (Ollama / Local Inference) ---
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3

# --- Multimodal Vision Model (Optional: Requires vision-capable Ollama model) ---
# VISION_LLM_MODEL=llama3.2-vision

# --- Pre-Shared Platform Secret Keys (Service-to-Service Authentication) ---
# Used for backend authorization across registered platforms
AXIOM_WEB_KEY=your-axiom-web-key-here
EDUCATION_PLATFORM_KEY=your-education-platform-key-here
